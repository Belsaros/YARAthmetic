#!/usr/bin/env python3

from itertools import combinations

CHARSET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def build_samples():
    samples = {}

    for value, char in enumerate(CHARSET):
        samples[ord(char)] = value
        samples[ord(char.upper())] = value

    return sorted(samples.items())


def terms_through_degree(degree):
    """Return ANF terms as tuples of input-bit numbers.

    ()      -> constant 1
    (0,)    -> x0
    (0, 3)  -> x0 & x3
    """
    terms = [()]

    for size in range(1, degree + 1):
        terms.extend(combinations(range(7), size))

    return terms


def evaluate_term(byte, term):
    result = 1

    for bit in term:
        result &= (byte >> bit) & 1

    return result


def solve_gf2(matrix, rhs):
    """Solve A*x=b over GF(2), returning one solution or None."""

    rows = []

    for coefficients, value in zip(matrix, rhs):
        row = 0

        for column, coefficient in enumerate(coefficients):
            if coefficient:
                row |= 1 << column

        if value:
            row |= 1 << len(coefficients)

        rows.append(row)

    columns = len(matrix[0])
    pivot_columns = []
    pivot_row = 0

    for column in range(columns):
        pivot = None

        for row in range(pivot_row, len(rows)):
            if (rows[row] >> column) & 1:
                pivot = row
                break

        if pivot is None:
            continue

        rows[pivot_row], rows[pivot] = rows[pivot], rows[pivot_row]

        for row in range(len(rows)):
            if row != pivot_row and ((rows[row] >> column) & 1):
                rows[row] ^= rows[pivot_row]

        pivot_columns.append(column)
        pivot_row += 1

    coefficient_mask = (1 << columns) - 1

    for row in rows:
        if (row & coefficient_mask) == 0 and ((row >> columns) & 1):
            return None

    solution = [0] * columns

    for row, column in enumerate(pivot_columns):
        solution[column] = (rows[row] >> columns) & 1

    return solution


def describe_term(term):
    if not term:
        return "1"

    return " & ".join(f"x{bit}" for bit in term)


samples = build_samples()

print(f"{len(samples)} distinct constrained ASCII inputs")
print()

solutions_by_bit = {}
for output_bit in range(5):
    print(f"output bit {output_bit}:")

    for degree in range(1, 8):
        terms = terms_through_degree(degree)

        matrix = [
            [evaluate_term(byte, term) for term in terms]
            for byte, _ in samples
        ]

        rhs = [
            (value >> output_bit) & 1
            for _, value in samples
        ]

        solution = solve_gf2(matrix, rhs)

        if solution is None:
            print(f"    degree {degree}: no solution")
            continue

        selected = [
            term
            for term, coefficient in zip(terms, solution)
            if coefficient
        ]

        solutions_by_bit[output_bit] = selected

        print(
            f"    degree {degree}: SOLUTION "
            f"({len(selected)} terms)"
        )
        print(
            "        "
            + " XOR ".join(describe_term(term) for term in selected)
        )
        break

    else:
        print("    no solution through degree 7")

    print()

def evaluate_anf(byte, terms):
    result = 0

    for term in terms:
        result ^= evaluate_term(byte, term)

    return result


def decode(byte):
    value = 0

    for output_bit in range(5):
        bit = evaluate_anf(byte, solutions_by_bit[output_bit])
        value |= bit << output_bit

    return value


print("verification:")
print()

failures = 0

for byte, expected in samples:
    actual = decode(byte)
    char = chr(byte)
    status = "OK" if actual == expected else "FAIL"

    print(
        f"    {char!r:3} {byte:3} -> "
        f"{actual:2} expected {expected:2} {status}"
    )

    if actual != expected:
        failures += 1

print()

if failures:
    print(f"FAILED: {failures} incorrect mappings")
    raise SystemExit(1)

print(f"PASS: all {len(samples)} constrained inputs mapped correctly")

print()
print("unconstrained ASCII mappings:")
print()

constrained = dict(samples)

for byte in range(128):
    if byte not in constrained:
        actual = decode(byte)

        print(
            f"    {byte:3} {byte:07b} "
            f"{chr(byte)!r:4} -> {actual:2}"
        )
